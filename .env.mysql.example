# ============================================
# MySQL Provider Configuration
# ============================================
# Use this file as a template when switching from SQLite to MySQL.
#
# Steps to switch to MySQL:
# 1. Copy this file to .env (or merge into existing .env)
# 2. Update DATABASE_URL with your MySQL connection details
# 3. Update provider in prisma/schema.prisma to "mysql"
# 4. Run: npx prisma migrate deploy
# 5. Restart the application (the write queue is automatically bypassed for MySQL)

# REQUIRED: MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/dnd_site

# Database provider must be set to "mysql"
DATABASE_PROVIDER=mysql

# ============================================
# MySQL-specific notes
# ============================================
# - The Operation Queue is automatically bypassed when using MySQL.
#   MySQL handles write concurrency natively via its transaction isolation levels.
# - DB_QUEUE_MAX_DEPTH and DB_QUEUE_WARN_MS are ignored when using MySQL.
# - Ensure the MySQL server has the target database created before running migrations.
# - Recommended: Use InnoDB engine (MySQL default) for full transaction support.
# - Connection pooling is managed by Prisma's connection pool (default pool size: 5).

# ============================================
# Other settings (same as SQLite)
# ============================================
GRAPHQL_INTROSPECTION=true
NODE_ENV=development
