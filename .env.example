# ============================================
# Data Storage & API Configuration
# ============================================

# REQUIRED: Prisma database connection string.
# For SQLite (default): file:./dev.db
# For MySQL: mysql://user:password@localhost:3306/dnd_site
DATABASE_URL=file:./dev.db

# Database provider: "sqlite" or "mysql"
DATABASE_PROVIDER=sqlite

# ============================================
# Operation Queue (SQLite only)
# ============================================

# Maximum number of write operations that can be queued.
# When exceeded, new writes are rejected with a QUEUE_FULL error.
# Default: 100
DB_QUEUE_MAX_DEPTH=100

# Warning threshold in milliseconds for queue wait time.
# Operations waiting longer than this will emit a warning log.
# Default: 500
DB_QUEUE_WARN_MS=500

# ============================================
# GraphQL Configuration
# ============================================

# Enable/disable GraphQL introspection.
# Defaults to "true" in development, "false" in production.
GRAPHQL_INTROSPECTION=true

# ============================================
# OAuth Provider Credentials
# ============================================

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth 2.0
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# GitHub OAuth 2.0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Facebook Login (OAuth 2.0)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Sign in with Apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Microsoft Account (Azure AD OAuth 2.0)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ============================================
# OAuth Configuration
# ============================================

# Base URL for OAuth callback URIs.
# In development this should match your Vite dev server URL.
# In production this should be your public-facing application URL.
OAUTH_REDIRECT_BASE_URL=http://localhost:5173

# ============================================
# Application Environment
# ============================================

# Controls development vs production behaviour.
# Values: "development", "production", "test"
NODE_ENV=development
