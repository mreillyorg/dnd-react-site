# ============================================
# Data Storage & API Configuration
# ============================================

# REQUIRED: MySQL connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/dnd_site

# Database provider: "mysql"
DATABASE_PROVIDER=mysql

# ============================================
# GraphQL Configuration
# ============================================

# Enable/disable GraphQL introspection.
# Defaults to "true" in development, "false" in production.
GRAPHQL_INTROSPECTION=true

# ============================================
# Better Auth Configuration
# ============================================

# Secret key for encryption and hashing (min 32 characters).
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL where the application server is hosted.
# In development this should match your Express server URL.
# In production this should be your public-facing application URL.
BETTER_AUTH_URL=http://localhost:5173

# ============================================
# OAuth Provider Credentials
# ============================================

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth 2.0
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# GitHub OAuth 2.0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Facebook Login (OAuth 2.0)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Sign in with Apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Microsoft Account (Azure AD OAuth 2.0)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ============================================
# Application Environment
# ============================================

# Controls development vs production behaviour.
# Values: "development", "production", "test"
NODE_ENV=development
